{
  "type": "object",
  "properties": {
    "g": {
      "type": "array",
      "description": "groups: the compound claims",
      "items": {
        "type": "object",
        "properties": {
          "t": { "type": "string", "description": "text: the compound claim as a short note: subject, colon, what the parts say together" },
          "k": { "type": "string", "description": "kind", "enum": ["behavior", "configuration", "requirement", "decision", "instruction", "rationale"] },
          "p": { "type": "array", "description": "parts: the numbers of the claims the compound claim is made of", "items": { "type": "integer" } }
        },
        "required": ["t", "k", "p"],
        "additionalProperties": false
      }
    },
    "r": {
      "type": "array",
      "description": "relations between two claims",
      "items": {
        "type": "object",
        "properties": {
          "a": { "type": "integer", "description": "the number of the first claim" },
          "b": { "type": "integer", "description": "the number of the second claim" },
          "k": { "type": "string", "description": "kind of relation", "enum": ["duplicates", "conflicts", "depends_on"] }
        },
        "required": ["a", "b", "k"],
        "additionalProperties": false
      }
    }
  },
  "required": ["g", "r"],
  "additionalProperties": false
}
